{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Debug - REST API (module)",
			"request": "launch",
			"type": "debugpy",
			"cwd": "${workspaceFolder}",
			"pythonArgs": [
				"-u"
			],
			"module": "src.api",
			"console": "integratedTerminal",
			"envFile": "${workspaceFolder}/.env",
			"env": {
				"PYTHONDONTWRITEBYTECODE": "1",
				"PYTHONUNBUFFERED": "1",
				"PYTHONIOENCODING": "utf-8"
			},
			"justMyCode": true
		}
	]
}
